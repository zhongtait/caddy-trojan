 	}
+	days, err := parseNonNegativeIntParam(daysRaw, "max_age_days")
+	if err != nil {
+		return err
+	}
+	maxPerUser, err := parseNonNegativeIntParam(q.Get("max_per_user"), "max_per_user")
+	if err != nil {
+		return err
+	}
+	if days == 0 && maxPerUser == 0 {
+		return caddy.APIError{
+			HTTPStatus: http.StatusBadRequest,
+			Err:        errors.New("specify max_age_days or max_per_user > 0"),
+		}
+	}
