+	wantV6 := strings.HasSuffix(network, "6")
+	if !wantV4 && !wantV6 {
+		return ips
+	}
+	out := make([]net.IP, 0, len(ips))
+	for _, ip := range ips {
+		isV4 := ip.To4() != nil
+		if (wantV4 && isV4) || (wantV6 && !isV4) {
+			out = append(out, ip)
+		}
+	}
+	return out
