+
+func TestMemoryUpstreamPersistenceFailureDoesNotMutateUsers(t *testing.T) {
+	persistErr := errors.New("storage unavailable")
+	persist := &recordingUpstream{addErr: persistErr, deleteErr: persistErr}
+	u := &MemoryUpstream{mm: make(map[string]Traffic)}
+	u.startPersistenceWorker(persist)
+	defer u.Cleanup()
+
+	password := "password"
+	keyBytes := [trojan.HeaderLen]byte{}
+	trojan.GenKey(password, keyBytes[:])
+	key := string(keyBytes[:])
+	if err := u.Add(password); !errors.Is(err, persistErr) {
