+	}
+}
+
+func TestMemoryUpstreamAddKeyPreservesTraffic(t *testing.T) {
+	u := &MemoryUpstream{mm: map[string]Traffic{"key": {Up: 12, Down: 34}}}
+	u.AddKey("key")
+	var got Traffic
+	u.Range(func(_ string, up, down int64) { got = Traffic{Up: up, Down: down} })
+	if got != (Traffic{Up: 12, Down: 34}) {
+		t.Fatalf("traffic = %#v, want existing counters preserved", got)
+	}
+}
+
+func TestTrojanStorageKeyValidation(t *testing.T) {
+	valid := "e440ce027e5051c38cdf3e47a3d469734e2de6e50d21ed2f0f460ba4"
+	if !isTrojanStorageKey(valid) {
+		t.Fatal("valid Trojan storage key was rejected")
+	}
+	for _, invalid := range []string{"1213882035", valid[:55], valid[:55] + "z"} {
+		if isTrojanStorageKey(invalid) {
+			t.Fatalf("invalid Trojan storage key was accepted: %q", invalid)
+		}
+	}
+}
