+
+func TestClientIPFromRequestUsesValidatedClientIP(t *testing.T) {
+	requestContext := context.WithValue(context.Background(), caddyhttp.VarsCtxKey, map[string]any{})
+	r, err := http.NewRequestWithContext(requestContext, http.MethodGet, "http://example.com", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r.RemoteAddr = "173.245.48.1:443"
+	caddyhttp.SetVar(r.Context(), caddyhttp.ClientIPVarKey, "198.51.100.20")
+	if got := clientIPFromRequest(r); got != "198.51.100.20" {
+		t.Fatalf("client IP = %q, want validated client IP", got)
+	}
+}
+
+func TestClientIPFromRequestFallsBackToPeer(t *testing.T) {
+	r, err := http.NewRequest(http.MethodGet, "http://example.com", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r.RemoteAddr = "192.0.2.10:443"
+	if got := clientIPFromRequest(r); got != "192.0.2.10" {
+		t.Fatalf("client IP = %q, want peer IP", got)
+	}
+}
+
+func TestUnmarshalCaddyfileWebSocketPath(t *testing.T) {
+	d := caddyfile.NewTestDispenser(`
+trojan {
+	connect_method
+	websocket /ws-secret
+}
+`)
+	var h Handler
+	if err := h.UnmarshalCaddyfile(d); err != nil {
+		t.Fatalf("UnmarshalCaddyfile() error = %v", err)
+	}
+	if !h.WebSocket || h.WebSocketPath != "/ws-secret" {
+		t.Fatalf("got (%v, %q), want (true, %q)", h.WebSocket, h.WebSocketPath, "/ws-secret")
+	}
+
+	dDefault := caddyfile.NewTestDispenser(`
+trojan {
+	websocket
+}
+`)
+	var hDefault Handler
+	if err := hDefault.UnmarshalCaddyfile(dDefault); err != nil {
+		t.Fatalf("UnmarshalCaddyfile() default error = %v", err)
+	}
+	if !hDefault.WebSocket || hDefault.WebSocketPath != "" {
+		t.Fatalf("got (%v, %q), want (true, empty)", hDefault.WebSocket, hDefault.WebSocketPath)
+	}
+
+	dBad := caddyfile.NewTestDispenser(`
+trojan {
+	websocket no-leading-slash
+}
+`)
+	var hBad Handler
+	if err := hBad.UnmarshalCaddyfile(dBad); err == nil {
+		t.Fatal("expected error for websocket path without leading '/'")
+	}
+}
+
+func TestServeHTTPWebSocketPathFiltering(t *testing.T) {
+	nextCalled := false
+	next := caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+		nextCalled = true
+		w.WriteHeader(http.StatusTeapot)
+		return nil
+	})
+
+	h := &Handler{
+		WebSocket:     true,
+		WebSocketPath: "/secret-ws",
+	}
+
+	// Non-matching path with Upgrade: websocket must fall through to camouflage next handler
+	req := httptest.NewRequest(http.MethodGet, "https://example.com/", nil)
+	req.Header.Set("Connection", "Upgrade")
+	req.Header.Set("Upgrade", "websocket")
+	rec := httptest.NewRecorder()
+	if err := h.ServeHTTP(rec, req, next); err != nil {
+		t.Fatalf("ServeHTTP(/) error = %v", err)
+	}
+	if !nextCalled || rec.Code != http.StatusTeapot {
+		t.Fatalf("expected fallthrough to next handler on '/', nextCalled=%v code=%d", nextCalled, rec.Code)
+	}
+
+	// Matching path must NOT fall through to next handler (enters WS upgrade path)
+	nextCalled = false
+	reqMatch := httptest.NewRequest(http.MethodGet, "https://example.com/secret-ws", nil)
+	reqMatch.Header.Set("Connection", "Upgrade")
+	reqMatch.Header.Set("Upgrade", "websocket")
+	recMatch := httptest.NewRecorder()
+	_ = h.ServeHTTP(recMatch, reqMatch, next)
+	if nextCalled {
+		t.Fatal("matching websocket path should not fall through to next handler")
+	}
+}
