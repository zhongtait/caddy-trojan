+func TestMemoryUpstreamResetTraffic(t *testing.T) {
+	u := &MemoryUpstream{
+		mm: make(map[string]Traffic),
+		tm: make(map[string]map[string]Traffic),
+	}
+	password := "client#with-space"
+	keyBytes := [trojan.HeaderLen]byte{}
+	trojan.GenKey(password, keyBytes[:])
+	key := x.ByteSliceToString(keyBytes[:])
+	u.AddKey(key)
+	if err := u.Consume(key, 10, 20); err != nil {
+		t.Fatal(err)
+	}
+	if err := u.ConsumeTarget(key, "203.0.113.10", "example.com:443", 10, 20); err != nil {
+		t.Fatal(err)
+	}
+	if err := u.ResetTraffic(key); err != nil {
+		t.Fatal(err)
+	}
+	var got Traffic
+	u.Range(func(k string, up, down int64) {
+		if k == key {
+			got = Traffic{Up: up, Down: down}
+		}
+	})
+	if got != (Traffic{}) {
+		t.Fatalf("user traffic was not reset: %+v", got)
+	}
+	count := 0
+	u.RangeTargets(func(k, ip, target string, up, down int64) { count++ })
+	if count != 0 {
+		t.Fatalf("target traffic was not reset: %d rows remain", count)
+	}
+}
+
+type slowResetUpstream struct {
+	mu           sync.Mutex
+	consumeCalls int
+	users        map[string]Traffic
+	targets      map[string]Traffic
+	resetStarted chan struct{}
+	releaseReset chan struct{}
+}
+
+func newSlowResetUpstream() *slowResetUpstream {
+	return &slowResetUpstream{
+		users:        make(map[string]Traffic),
+		targets:      make(map[string]Traffic),
+		resetStarted: make(chan struct{}),
+		releaseReset: make(chan struct{}),
+	}
+}
+
+func (s *slowResetUpstream) Add(string) error { return nil }
+func (s *slowResetUpstream) Delete(string) error {
+	return nil
+}
+func (s *slowResetUpstream) Range(fn func(string, int64, int64)) {}
+func (s *slowResetUpstream) Validate(string) bool                { return true }
+func (s *slowResetUpstream) Consume(k string, nr, nw int64) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.consumeCalls++
+	t := s.users[k]
+	t.Up += nr
+	t.Down += nw
+	s.users[k] = t
+	return nil
+}
+func (s *slowResetUpstream) ConsumeTarget(k, ip, target string, nr, nw int64) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	tk := k + "/" + targetKeyString(ip, target)
+	t := s.targets[tk]
+	t.Up += nr
+	t.Down += nw
+	s.targets[tk] = t
+	return nil
+}
+func (s *slowResetUpstream) RangeTargets(fn func(string, string, string, int64, int64)) {}
+func (s *slowResetUpstream) ResetTraffic(key string) error {
+	close(s.resetStarted)
+	<-s.releaseReset
+	s.mu.Lock()
+	defer s.mu.Unlock()
