+	filterIP := r.URL.Query().Get("ip")
+	filterTarget := r.URL.Query().Get("target")
+	rows := make([]app.TargetTraffic, 0)
+	targets.RangeTargets(func(key, ip, target string, up, down int64) {
+		if filterKey != "" && filterKey != key {
+			return
+		}
+		if filterIP != "" && filterIP != ip {
+			return
+		}
+		if filterTarget != "" && filterTarget != target {
+			return
+		}
+		rows = append(rows, app.TargetTraffic{Key: key, IP: ip, Target: target, Traffic: app.Traffic{Up: up, Down: down}})
+	})
+	sort.Slice(rows, func(i, j int) bool {
+		if rows[i].Key != rows[j].Key {
+			return rows[i].Key < rows[j].Key
+		}
+		if rows[i].IP != rows[j].IP {
+			return rows[i].IP < rows[j].IP
+		}
+		return rows[i].Target < rows[j].Target
+	})
+	w.WriteHeader(http.StatusOK)
+	return json.NewEncoder(w).Encode(rows)
+}
