+
+func (p *NoProxy) dialContext(ctx context.Context, network, addr string) (net.Conn, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if p.Network == "" || !isTCPOrUDP(network) {
+		return (&net.Dialer{}).DialContext(ctx, network, addr)
+	}
+	host, port, err := net.SplitHostPort(addr)
+	if err != nil || isIPLiteral(host) {
+		return (&net.Dialer{}).DialContext(ctx, network, addr)
+	}
+	ips, err := net.DefaultResolver.LookupIP(ctx, "ip", host)
+	if err != nil {
+		return nil, err
+	}
+	primary, fallback := p.prioritizedIPs(ips)
+	if isUDPNetwork(network) {
+		if len(primary) == 0 {
+			primary = fallback
+		}
+		if len(primary) == 0 {
+			return nil, fmt.Errorf("no IP address found for %s", host)
+		}
+		return (&net.Dialer{}).DialContext(ctx, network, net.JoinHostPort(primary[0].String(), port))
+	}
+	return dialTCPPreferred(ctx, network, port, primary, fallback)
+}
+
+func isTCPOrUDP(network string) bool {
+	return isTCPNetwork(network) || isUDPNetwork(network)
+}
+
+func isTCPNetwork(network string) bool {
+	return network == "tcp" || network == "tcp4" || network == "tcp6"
+}
+
+func isUDPNetwork(network string) bool {
+	return network == "udp" || network == "udp4" || network == "udp6"
+}
+
+func isIPLiteral(host string) bool {
+	_, err := netip.ParseAddr(host)
+	return err == nil
 }
 
