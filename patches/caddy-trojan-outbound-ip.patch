+		t.Fatal("closed upstream accepted a late in-memory mutation")
+	}
+}
+
+func TestMemoryUpstreamCleanupWaitsForAsyncPersistence(t *testing.T) {
+	persist := &blockingUpstream{
+		consumeStarted: make(chan struct{}),
+		releaseConsume: make(chan struct{}),
+	}
+	u := &MemoryUpstream{mm: make(map[string]Traffic)}
+	u.startPersistenceWorker(persist)
+
+	if err := u.Consume("key", 1, 2); err != nil {
