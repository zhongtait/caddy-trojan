+package app
+
+import (
+	"testing"
+
+	"github.com/imgk/caddy-trojan/pkgs/trojan"
+	"github.com/imgk/caddy-trojan/pkgs/x"
+)
+
+func TestMemoryUpstreamResetTraffic(t *testing.T) {
+	u := &MemoryUpstream{
+		mm: make(map[string]Traffic),
+		tm: make(map[string]map[string]Traffic),
+	}
+	password := "client#with-space"
+	keyBytes := [trojan.HeaderLen]byte{}
+	trojan.GenKey(password, keyBytes[:])
+	key := x.ByteSliceToString(keyBytes[:])
+	u.AddKey(key)
+	if err := u.Consume(key, 10, 20); err != nil {
+		t.Fatal(err)
+	}
+	if err := u.ConsumeTarget(key, "203.0.113.10", "example.com:443", 10, 20); err != nil {
+		t.Fatal(err)
+	}
+	if err := u.ResetTraffic(key); err != nil {
+		t.Fatal(err)
+	}
+	var got Traffic
+	u.Range(func(k string, up, down int64) {
+		if k == key {
+			got = Traffic{Up: up, Down: down}
+		}
+	})
+	if got != (Traffic{}) {
+		t.Fatalf("user traffic was not reset: %+v", got)
+	}
+	count := 0
+	u.RangeTargets(func(k, ip, target string, up, down int64) { count++ })
+	if count != 0 {
+		t.Fatalf("target traffic was not reset: %d rows remain", count)
+	}
+}
