+
+func (u *CaddyUpstream) ResetTraffic(key string) error {
+	if key != "" {
+		if !isTrojanStorageKey(key) {
+			return errors.New("invalid Trojan traffic key")
+		}
+		if _, err := u.storage.Load(context.Background(), u.prefix+key); errors.Is(err, fs.ErrNotExist) {
+			return nil
+		} else if err != nil {
+			return err
+		}
+		storageKey := u.prefix + key
+		u.storage.Lock(context.Background(), storageKey)
+		err := u.storage.Store(context.Background(), storageKey, []byte(`{"up":0,"down":0}`))
+		u.storage.Unlock(context.Background(), storageKey)
+		if err != nil {
+			return err
+		}
+	}
+	prefix := u.prefix + targetPrefix
+	keys, err := u.storage.List(context.Background(), prefix, true)
+	if err != nil && !errors.Is(err, fs.ErrNotExist) {
+		return err
+	}
+	for _, targetKey := range keys {
+		rel := strings.TrimPrefix(targetKey, prefix)
+		parts := strings.SplitN(rel, "/", 2)
+		if len(parts) != 2 || (key != "" && parts[0] != key) {
+			continue
+		}
+		u.storage.Lock(context.Background(), targetKey)
+		err = u.storage.Delete(context.Background(), targetKey)
+		u.storage.Unlock(context.Background(), targetKey)
+		if err != nil && !errors.Is(err, fs.ErrNotExist) {
+			return err
+		}
+	}
+	if key == "" {
+		users, err := u.storage.List(context.Background(), u.prefix, false)
+		if err != nil && !errors.Is(err, fs.ErrNotExist) {
+			return err
+		}
+		for _, userKey := range users {
+			userKey = strings.TrimPrefix(userKey, u.prefix)
+			if isTrojanStorageKey(userKey) {
+				storageKey := u.prefix + userKey
+				u.storage.Lock(context.Background(), storageKey)
+				err := u.storage.Store(context.Background(), storageKey, []byte(`{"up":0,"down":0}`))
+				u.storage.Unlock(context.Background(), storageKey)
+				if err != nil {
+					return err
+				}
+			}
+		}
+	}
+	return nil
+}
