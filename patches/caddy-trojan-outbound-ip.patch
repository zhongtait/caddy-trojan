+func (al *Admin) Traffic(w http.ResponseWriter, r *http.Request) error {
+	if r.Method == http.MethodDelete {
+		resetter, ok := al.upstream.(app.TrafficResetter)
+		if !ok {
+			return errors.New("trojan traffic reset is unavailable")
+		}
+		if err := resetter.ResetTraffic(r.URL.Query().Get("key")); err != nil {
+			return err
+		}
+		w.WriteHeader(http.StatusNoContent)
+		return nil
+	}
+	if r.Method != http.MethodGet {
+		return errors.New("trojan traffic method error")
+	}
+	q := r.URL.Query()
+	filterKey := q.Get("key")
+	filterIP := q.Get("ip")
+	filterTarget := q.Get("target")
+	sortBy := strings.ToLower(q.Get("sort"))
+	switch sortBy {
+	case "", "default", "total", "up", "down", "key", "ip", "target":
+	default:
+		return caddy.APIError{
+			HTTPStatus: http.StatusBadRequest,
+			Err:        errors.New("invalid sort parameter (allowed: total, up, down, key, ip, target)"),
+		}
+	}
+	offset, err := parseNonNegativeIntParam(q.Get("offset"), "offset")
+	if err != nil {
+		return err
+	}
+	limit, err := parseNonNegativeIntParam(q.Get("limit"), "limit")
+	if err != nil {
+		return err
+	}
+
+	rows := make([]app.TargetTraffic, 0)
+	appendRow := func(row app.TargetTraffic) {
+		if filterKey != "" && filterKey != row.Key {
+			return
+		}
+		if filterIP != "" && filterIP != row.IP {
+			return
+		}
+		if filterTarget != "" && filterTarget != row.Target {
+			return
+		}
+		rows = append(rows, row)
+	}
+	if details, ok := al.upstream.(app.TargetDetailUpstream); ok {
+		details.RangeTargetDetails(appendRow)
+	} else if targets, ok := al.upstream.(app.TargetUpstream); ok {
+		targets.RangeTargets(func(key, ip, target string, up, down int64) {
+			appendRow(app.TargetTraffic{Key: key, IP: ip, Target: target, Traffic: app.Traffic{Up: up, Down: down}})
+		})
+	} else {
+		return errors.New("trojan target traffic is unavailable")
+	}
+
+	compareDefault := func(i, j int) bool {
+		if rows[i].Key != rows[j].Key {
+			return rows[i].Key < rows[j].Key
+		}
+		if rows[i].IP != rows[j].IP {
+			return rows[i].IP < rows[j].IP
+		}
+		return rows[i].Target < rows[j].Target
+	}
+	sort.Slice(rows, func(i, j int) bool {
+		switch sortBy {
+		case "total":
+			ti := rows[i].Up + rows[i].Down
+			tj := rows[j].Up + rows[j].Down
+			if ti != tj {
+				return ti > tj
+			}
+		case "up":
+			if rows[i].Up != rows[j].Up {
+				return rows[i].Up > rows[j].Up
+			}
+		case "down":
+			if rows[i].Down != rows[j].Down {
+				return rows[i].Down > rows[j].Down
+			}
+		case "ip":
+			if rows[i].IP != rows[j].IP {
+				return rows[i].IP < rows[j].IP
+			}
+		case "target":
+			li := strings.ToLower(rows[i].Target)
+			lj := strings.ToLower(rows[j].Target)
+			if li != lj {
+				return li < lj
+			}
+		case "key":
+			if rows[i].Key != rows[j].Key {
+				return rows[i].Key < rows[j].Key
+			}
+		}
+		return compareDefault(i, j)
+	})
+
+	if offset >= len(rows) {
+		rows = rows[:0]
+	} else if offset > 0 {
+		rows = rows[offset:]
+	}
+	if limit > 0 && limit < len(rows) {
+		rows = rows[:limit]
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusOK)
+	return json.NewEncoder(w).Encode(rows)
 }
 
