+}
+
+func (p *NoProxy) dialContext(ctx context.Context, network, addr string) (net.Conn, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if !isTCPOrUDP(network) {
+		return p.dialWithContext(ctx, network, addr)
+	}
+	host, port, err := net.SplitHostPort(addr)
+	if err != nil || isIPLiteral(host) {
+		return p.dialWithContext(ctx, network, addr)
+	}
+	ips, err := p.resolveCached(ctx, host)
+	if err != nil {
+		return nil, err
+	}
+	ips = filterIPsForNetwork(network, ips)
+	if len(ips) == 0 {
+		return nil, fmt.Errorf("no IP address found for %s", host)
+	}
+
+	hostKey := strings.ToLower(strings.TrimSuffix(host, "."))
+	cache := p.getCache()
+	now := p.now()
+	preferredV4, hasFamilyPref := cache.preferredFamily(hostKey, now)
+
+	primary, fallback := p.prioritizedIPsWithHint(ips, preferredV4, hasFamilyPref)
+	if isUDPNetwork(network) {
+		if len(primary) == 0 {
+			primary = fallback
+		}
+		if len(primary) == 0 {
+			return nil, fmt.Errorf("no IP address found for %s", host)
+		}
+		return p.dialWithContext(ctx, network, net.JoinHostPort(primary[0].String(), port))
+	}
+
+	fallbackDelay := noProxyFallbackDelay
+	if p.Network != "" && hasFamilyPref {
+		configuredV4 := p.Network == "ipv4"
+		if preferredV4 != configuredV4 {
+			fallbackDelay = noProxyFastFallbackDelay
+		}
+	}
+	initialPrimaryV4 := len(primary) > 0 && primary[0].To4() != nil
+	conn, wonIPv4, err := dialTCPPreferred(ctx, network, port, primary, fallback, fallbackDelay, p.dialWithContext)
+	if err == nil && len(primary) > 0 && len(fallback) > 0 {
+		cache.recordFamilyOutcome(hostKey, wonIPv4, initialPrimaryV4, p.now())
+	}
+	return conn, err
+}
+
+func isTCPOrUDP(network string) bool {
+	return isTCPNetwork(network) || isUDPNetwork(network)
+}
+
+func isTCPNetwork(network string) bool {
+	return network == "tcp" || network == "tcp4" || network == "tcp6"
+}
+
+func isUDPNetwork(network string) bool {
+	return network == "udp" || network == "udp4" || network == "udp6"
+}
+
+func isIPLiteral(host string) bool {
+	_, err := netip.ParseAddr(host)
+	return err == nil
 }
 
 func (*NoProxy) ListenPacket(network, addr string) (net.PacketConn, error) {
 	return net.ListenPacket(network, addr)
 }
 
+func (p *NoProxy) prioritizedIPs(ips []net.IP) (primary, fallback []net.IP) {
+	return p.prioritizedIPsWithHint(ips, false, false)
+}
+
+func (p *NoProxy) prioritizedIPsWithHint(ips []net.IP, preferredV4, hasFamilyPref bool) (primary, fallback []net.IP) {
+	if p.Network == "ipv4" || p.Network == "ipv6" {
+		for _, ip := range ips {
+			isV4 := ip.To4() != nil
+			if (p.Network == "ipv4" && isV4) || (p.Network == "ipv6" && !isV4) {
+				primary = append(primary, ip)
+			} else {
+				fallback = append(fallback, ip)
+			}
+		}
+		return primary, fallback
+	}
+	if len(ips) == 0 {
+		return nil, nil
+	}
+	firstIsV4 := ips[0].To4() != nil
+	if hasFamilyPref {
+		firstIsV4 = preferredV4
+	}
+	for _, ip := range ips {
+		isV4 := ip.To4() != nil
+		if isV4 == firstIsV4 {
+			primary = append(primary, ip)
+		} else {
+			fallback = append(fallback, ip)
+		}
+	}
+	return primary, fallback
+}
+
+func dialTCPPreferred(
+	parent context.Context,
+	network, port string,
+	primary, fallback []net.IP,
+	fallbackDelay time.Duration,
+	dialFn func(ctx context.Context, network, addr string) (net.Conn, error),
+) (net.Conn, bool, error) {
+	type result struct {
+		conn net.Conn
+		err  error
+		ipv4 bool
+	}
+	if len(primary) == 0 {
+		primary, fallback = fallback, nil
+	}
+	if len(primary) == 0 {
+		return nil, false, errors.New("no IP address found")
+	}
+	if fallbackDelay <= 0 {
+		fallbackDelay = noProxyFallbackDelay
+	}
+	if dialFn == nil {
+		dialFn = (&net.Dialer{}).DialContext
+	}
+	ctx, cancel := context.WithCancel(parent)
+	defer cancel()
+	results := make(chan result, len(primary)+len(fallback))
+	var workers sync.WaitGroup
+	dial := func(ip net.IP, ipv4 bool) {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			conn, err := dialFn(ctx, network, net.JoinHostPort(ip.String(), port))
+			results <- result{conn: conn, err: err, ipv4: ipv4}
+		}()
+	}
+	cleanup := func() {
+		cancel()
+		go func() {
+			workers.Wait()
+			close(results)
+			for got := range results {
+				if got.conn != nil {
+					_ = got.conn.Close()
+				}
+			}
+		}()
+	}
+
+	dial(primary[0], primary[0].To4() != nil)
+	primaryNext, fallbackNext, pending := 1, 0, 1
+	timer := time.NewTimer(fallbackDelay)
+	defer timer.Stop()
+	var timerC <-chan time.Time = timer.C
+	primaryV4 := primary[0].To4() != nil
+	var lastErr error
+	for pending > 0 {
+		select {
+		case <-ctx.Done():
+			cleanup()
+			return nil, false, ctx.Err()
+		case got := <-results:
+			pending--
+			if got.err == nil {
+				cleanup()
+				return got.conn, got.ipv4, nil
+			}
+			if got.conn != nil {
+				_ = got.conn.Close()
+			}
+			lastErr = got.err
+			if got.ipv4 == primaryV4 && primaryNext < len(primary) {
+				dial(primary[primaryNext], primary[primaryNext].To4() != nil)
+				primaryNext++
+				pending++
+			} else if fallbackNext < len(fallback) {
+				dial(fallback[fallbackNext], fallback[fallbackNext].To4() != nil)
+				fallbackNext++
+				pending++
+			}
+		case <-timerC:
+			if ctx.Err() != nil {
+				cleanup()
+				return nil, false, ctx.Err()
+			}
+			if fallbackNext < len(fallback) {
+				dial(fallback[fallbackNext], fallback[fallbackNext].To4() != nil)
+				fallbackNext++
+				pending++
+			}
+			timerC = nil
+		}
+	}
+	cancel()
+	return nil, false, lastErr
+}
+
