+func (u *CaddyUpstream) PruneTargets(maxAge time.Duration, maxPerUser int) (int, error) {
+	if maxAge < 0 || maxPerUser < 0 {
+		return 0, errors.New("prune parameters must be non-negative")
+	}
+	if maxAge == 0 && maxPerUser == 0 {
+		return 0, nil
+	}
+	records, _, err := u.listTargetRecords()
+	if err != nil {
+		return 0, err
+	}
+	if len(records) == 0 {
+		return 0, nil
+	}
+
+	if maxAge > 0 {
+		needStat := make([]int, 0)
+		for index := range records {
+			if records[index].UpdatedAt <= 0 {
+				needStat = append(needStat, index)
+			}
+		}
+		runTargetWorkers(len(needStat), func(pos int) {
+			index := needStat[pos]
+			if info, statErr := u.storage.Stat(context.Background(), records[index].storageKey); statErr == nil {
+				records[index].UpdatedAt = info.Modified.Unix()
+			}
+		})
+	}
+
+	now := time.Now().Unix()
+	maxAgeSec := int64(maxAge / time.Second)
+	toDelete := make([]string, 0)
+	byUser := make(map[string][]caddyTargetRecord)
+	for _, rec := range records {
+		if maxAge > 0 && rec.UpdatedAt > 0 && now-rec.UpdatedAt > maxAgeSec {
+			toDelete = append(toDelete, rec.storageKey)
+			continue
+		}
+		if maxPerUser > 0 {
+			byUser[rec.Key] = append(byUser[rec.Key], rec)
+		}
+	}
+	if maxPerUser > 0 {
+		for _, userRecords := range byUser {
+			if len(userRecords) <= maxPerUser {
+				continue
+			}
+			sort.Slice(userRecords, func(i, j int) bool {
+				if userRecords[i].UpdatedAt != userRecords[j].UpdatedAt {
+					return userRecords[i].UpdatedAt > userRecords[j].UpdatedAt
+				}
+				ti := userRecords[i].Up + userRecords[i].Down
+				tj := userRecords[j].Up + userRecords[j].Down
+				if ti != tj {
+					return ti > tj
+				}
+				return userRecords[i].storageKey < userRecords[j].storageKey
+			})
+			for _, drop := range userRecords[maxPerUser:] {
+				toDelete = append(toDelete, drop.storageKey)
+			}
+		}
+	}
+	if len(toDelete) == 0 {
+		return 0, nil
+	}
+	deleteErrors := make([]error, len(toDelete))
+	runTargetWorkers(len(toDelete), func(index int) {
+		deleteErrors[index] = u.storage.Delete(context.Background(), toDelete[index])
+		if errors.Is(deleteErrors[index], fs.ErrNotExist) {
+			deleteErrors[index] = nil
+		}
+	})
+	for _, err := range deleteErrors {
+		if err != nil {
+			return 0, err
+		}
+	}
+	return len(toDelete), nil
+}
+
+func (u *CaddyUpstream) ResetTraffic(key string) error {
+	if key != "" {
+		if !isTrojanStorageKey(key) {
+			return errors.New("invalid Trojan traffic key")
+		}
+		if _, err := u.storage.Load(context.Background(), u.prefix+key); errors.Is(err, fs.ErrNotExist) {
+			return nil
+		} else if err != nil {
+			return err
+		}
+		storageKey := u.prefix + key
+		u.storage.Lock(context.Background(), storageKey)
+		err := u.storage.Store(context.Background(), storageKey, []byte(`{"up":0,"down":0}`))
+		u.storage.Unlock(context.Background(), storageKey)
+		if err != nil {
+			return err
+		}
+	}
+	prefix := u.prefix + targetPrefix
+	keys, err := u.storage.List(context.Background(), prefix, true)
+	if err != nil && !errors.Is(err, fs.ErrNotExist) {
+		return err
+	}
+	targetKeys := make([]string, 0, len(keys))
+	for _, targetKey := range keys {
+		rel := strings.TrimPrefix(targetKey, prefix)
+		parts := strings.SplitN(rel, "/", 2)
+		if len(parts) == 2 && (key == "" || parts[0] == key) {
+			targetKeys = append(targetKeys, targetKey)
+		}
+	}
+	deleteErrors := make([]error, len(targetKeys))
+	runTargetWorkers(len(targetKeys), func(index int) {
+		deleteErrors[index] = u.storage.Delete(context.Background(), targetKeys[index])
+		if errors.Is(deleteErrors[index], fs.ErrNotExist) {
+			deleteErrors[index] = nil
+		}
+	})
+	for _, err := range deleteErrors {
+		if err != nil {
+			return err
+		}
+	}
+	if key == "" {
+		users, err := u.storage.List(context.Background(), u.prefix, false)
+		if err != nil && !errors.Is(err, fs.ErrNotExist) {
+			return err
+		}
+		userStorageKeys := make([]string, 0, len(users))
+		for _, userKey := range users {
+			trimmed := strings.TrimPrefix(userKey, u.prefix)
+			if isTrojanStorageKey(trimmed) {
+				userStorageKeys = append(userStorageKeys, u.prefix+trimmed)
+			}
+		}
+		resetErrors := make([]error, len(userStorageKeys))
+		runTargetWorkers(len(userStorageKeys), func(index int) {
+			storageKey := userStorageKeys[index]
+			u.storage.Lock(context.Background(), storageKey)
+			resetErrors[index] = u.storage.Store(context.Background(), storageKey, []byte(`{"up":0,"down":0}`))
+			u.storage.Unlock(context.Background(), storageKey)
+		})
+		for _, err := range resetErrors {
+			if err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
