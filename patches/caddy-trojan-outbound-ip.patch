+func (c *noProxyCache) preferredFamily(key string, now time.Time) (preferIPv4 bool, ok bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	entry, exists := c.families[key]
+	if !exists || !now.Before(entry.expiresAt) {
+		if exists {
