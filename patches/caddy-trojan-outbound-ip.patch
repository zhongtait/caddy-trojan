@@ -0,0 +1,141 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestNoProxyDNSPositiveNegativeCacheAndExpiry(t *testing.T) {
+	now := time.Unix(1_700_000_000, 0)
+	var mu sync.Mutex
+	var lookups atomic.Int32
+	lookupErr := error(nil)
+	resolvedIPs := []net.IP{net.ParseIP("93.184.216.34")}
+
+	p := &NoProxy{
+		cache: newNoProxyCache(),
+		nowFn: func() time.Time {
+			mu.Lock()
+			defer mu.Unlock()
+			return now
+		},
+		lookupIP: func(ctx context.Context, network, host string) ([]net.IP, error) {
+			lookups.Add(1)
+			mu.Lock()
+			defer mu.Unlock()
+			if lookupErr != nil {
+				return nil, lookupErr
+			}
+			return resolvedIPs, nil
+		},
+		dialFn: func(ctx context.Context, network, addr string) (net.Conn, error) {
+			c1, c2 := net.Pipe()
+			_ = c2.Close()
+			return c1, nil
+		},
+	}
+
+	// 1. Positive cache hit within 30s
+	for i := 0; i < 3; i++ {
+		conn, err := p.dialContext(context.Background(), "tcp", "example.com:443")
+		if err != nil {
+			t.Fatalf("dial %d error = %v", i, err)
+		}
+		_ = conn.Close()
+	}
+	if lookups.Load() != 1 {
+		t.Fatalf("lookups = %d, want 1 positive cached lookup", lookups.Load())
+	}
+
+	// 2. Expiry after 31s triggers fresh lookup, and permanent DNS error is negative-cached for 5s
+	mu.Lock()
+	now = now.Add(31 * time.Second)
+	lookupErr = &net.DNSError{Err: "no such host", Name: "example.com", IsNotFound: true}
+	mu.Unlock()
+
+	if _, err := p.dialContext(context.Background(), "tcp", "example.com:443"); err == nil {
+		t.Fatal("expected DNS error on expired refresh")
+	}
+	if _, err := p.dialContext(context.Background(), "tcp", "example.com:443"); err == nil {
+		t.Fatal("expected cached negative DNS error")
+	}
+	if lookups.Load() != 2 {
+		t.Fatalf("lookups = %d, want 2 (negative cache hit)", lookups.Load())
+	}
+
+	// 3. After 6s negative TTL expires and succeeds again
+	mu.Lock()
+	now = now.Add(6 * time.Second)
+	lookupErr = nil
+	mu.Unlock()
+
+	conn, err := p.dialContext(context.Background(), "tcp", "example.com:443")
+	if err != nil {
+		t.Fatalf("dial after negative TTL error = %v", err)
+	}
+	_ = conn.Close()
+	if lookups.Load() != 3 {
+		t.Fatalf("lookups = %d, want 3 after negative TTL expiry", lookups.Load())
+	}
+}
+
+func TestNoProxyHappyEyeballsFamilyMemory(t *testing.T) {
+	now := time.Unix(1_700_000_000, 0)
+	var mu sync.Mutex
+	var dialedAddrs []string
+
+	p := &NoProxy{
+		cache: newNoProxyCache(),
+		nowFn: func() time.Time {
+			mu.Lock()
+			defer mu.Unlock()
+			return now
+		},
+		lookupIP: func(ctx context.Context, network, host string) ([]net.IP, error) {
+			// Return IPv6 first, then IPv4
+			return []net.IP{net.ParseIP("2001:db8::1"), net.ParseIP("93.184.216.34")}, nil
+		},
+		dialFn: func(ctx context.Context, network, addr string) (net.Conn, error) {
+			mu.Lock()
+			dialedAddrs = append(dialedAddrs, addr)
+			mu.Unlock()
+			host, _, _ := net.SplitHostPort(addr)
+			if ip := net.ParseIP(host); ip != nil && ip.To4() == nil {
+				return nil, errors.New("ipv6 unreachable")
+			}
+			c1, c2 := net.Pipe()
+			_ = c2.Close()
+			return c1, nil
+		},
+	}
+
+	// First dial tries IPv6 first, fails, falls back to IPv4 and records IPv4 preference
+	conn, err := p.dialContext(context.Background(), "tcp", "dualstack.example.com:443")
+	if err != nil {
+		t.Fatalf("first dial error = %v", err)
+	}
+	_ = conn.Close()
+
+	mu.Lock()
+	dialedAddrs = nil
+	mu.Unlock()
+
+	// Second dial within 2 minutes must prefer IPv4 immediately without touching IPv6
+	conn, err = p.dialContext(context.Background(), "tcp", "dualstack.example.com:443")
+	if err != nil {
+		t.Fatalf("second dial error = %v", err)
+	}
+	_ = conn.Close()
+
+	mu.Lock()
+	got := append([]string(nil), dialedAddrs...)
+	mu.Unlock()
+	if len(got) != 1 || got[0] != "93.184.216.34:443" {
+		t.Fatalf("second dial addrs = %v, want [93.184.216.34:443]", got)
+	}
+}
