@@ -0,0 +1,66 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestNoProxyDialTimeout(t *testing.T) {
+	if noProxyDialTimeout != 10*time.Second {
+		t.Fatalf("noProxyDialTimeout = %v, want 10s", noProxyDialTimeout)
+	}
+}
+
+func TestNoProxyDialContextCanceledDNS(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	conn, err := (&NoProxy{Network: "ipv4"}).dialContext(ctx, "tcp", "timeout.invalid:443")
+	if conn != nil {
+		_ = conn.Close()
+		t.Fatal("dialContext returned a connection for a canceled DNS lookup")
+	}
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("dialContext error = %v, want context.Canceled", err)
+	}
+}
+
+func TestNoProxyDialContextCanceledIPLiteral(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	conn, err := (&NoProxy{Network: "ipv4"}).dialContext(ctx, "tcp", "192.0.2.1:443")
+	if conn != nil {
+		_ = conn.Close()
+		t.Fatal("dialContext returned a connection for a canceled IP-literal dial")
+	}
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("dialContext error = %v, want context.Canceled", err)
+	}
+}
+
+func TestDialTCPPreferredCanceled(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	conn, err := dialTCPPreferred(ctx, "tcp", "443", []net.IP{net.ParseIP("127.0.0.1")}, nil)
+	if conn != nil {
+		_ = conn.Close()
+		t.Fatal("dialTCPPreferred returned a connection for a canceled context")
+	}
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("dialTCPPreferred error = %v, want context.Canceled", err)
+	}
+}
+
+func TestIsIPLiteralWithIPv6Zone(t *testing.T) {
+	if !isIPLiteral("fe80::1%eth0") {
+		t.Fatal("isIPLiteral rejected an IPv6 literal with a zone")
+	}
+	if isIPLiteral("example.com") {
+		t.Fatal("isIPLiteral accepted a domain name")
+	}
+}
