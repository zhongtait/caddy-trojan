+	defer c.mu.Unlock()
+	if wonIPv4 == primaryWasIPv4 {
+		// Primary family succeeded as expected; clear any prior fallback preference
+		delete(c.families, key)
+		return
+	}
+	if len(c.families) >= noProxyMaxCacheEntries {
+		c.pruneExpiredLocked(now)
+		for k := range c.families {
+			if len(c.families) < noProxyMaxCacheEntries {
+				break
+			}
+			delete(c.families, k)
+		}
+	}
+	c.families[key] = familyPrefEntry{
+		preferIPv4: wonIPv4,
+		expiresAt:  now.Add(noProxyFamilyMemoryTTL),
+	}
