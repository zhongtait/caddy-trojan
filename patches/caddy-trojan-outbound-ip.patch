+		s.users = make(map[string]Traffic)
+		s.targets = make(map[string]Traffic)
+	} else {
+		delete(s.users, key)
+	}
+	return nil
+}
+
+func TestMemoryUpstreamConsumeDoesNotBlockDuringReset(t *testing.T) {
+	backing := newSlowResetUpstream()
+	u := &MemoryUpstream{
+		mm:             make(map[string]Traffic),
+		tm:             make(map[string]map[string]Traffic),
