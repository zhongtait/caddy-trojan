+
+func (p *NoProxy) dialContext(ctx context.Context, network, addr string) (net.Conn, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if p.Network == "" || !isTCPOrUDP(network) {
+		return (&net.Dialer{}).DialContext(ctx, network, addr)
+	}
+	host, port, err := net.SplitHostPort(addr)
+	if err != nil || isIPLiteral(host) {
+		return (&net.Dialer{}).DialContext(ctx, network, addr)
+	}
+	ips, err := net.DefaultResolver.LookupIP(ctx, "ip", host)
+	if err != nil {
+		return nil, err
+	}
+	primary, fallback := p.prioritizedIPs(ips)
+	if isUDPNetwork(network) {
+		if len(primary) == 0 {
+			primary = fallback
+		}
+		if len(primary) == 0 {
+			return nil, fmt.Errorf("no IP address found for %s", host)
+		}
+		return (&net.Dialer{}).DialContext(ctx, network, net.JoinHostPort(primary[0].String(), port))
+	}
+	return dialTCPPreferred(ctx, network, port, primary, fallback)
+}
+
+func isTCPOrUDP(network string) bool {
+	return isTCPNetwork(network) || isUDPNetwork(network)
+}
+
+func isTCPNetwork(network string) bool {
+	return network == "tcp" || network == "tcp4" || network == "tcp6"
+}
+
+func isUDPNetwork(network string) bool {
+	return network == "udp" || network == "udp4" || network == "udp6"
+}
+
+func isIPLiteral(host string) bool {
+	_, err := netip.ParseAddr(host)
+	return err == nil
 }
 
 func (*NoProxy) ListenPacket(network, addr string) (net.PacketConn, error) {
 	return net.ListenPacket(network, addr)
 }
 
+func (p *NoProxy) prioritizedIPs(ips []net.IP) (primary, fallback []net.IP) {
+	for _, ip := range ips {
+		isV4 := ip.To4() != nil
+		if (p.Network == "ipv4" && isV4) || (p.Network == "ipv6" && !isV4) {
+			primary = append(primary, ip)
+		} else {
+			fallback = append(fallback, ip)
+		}
+	}
+	return primary, fallback
+}
+
+func dialTCPPreferred(parent context.Context, network, port string, primary, fallback []net.IP) (net.Conn, error) {
+	type result struct {
+		conn net.Conn
+		err  error
+		ipv4 bool
+	}
+	if len(primary) == 0 {
+		primary, fallback = fallback, nil
+	}
+	if len(primary) == 0 {
+		return nil, errors.New("no IP address found")
+	}
+	ctx, cancel := context.WithCancel(parent)
+	defer cancel()
+	results := make(chan result, len(primary)+len(fallback))
+	var workers sync.WaitGroup
+	dial := func(ip net.IP, ipv4 bool) {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			conn, err := (&net.Dialer{}).DialContext(ctx, network, net.JoinHostPort(ip.String(), port))
+			results <- result{conn: conn, err: err, ipv4: ipv4}
+		}()
+	}
+	cleanup := func() {
+		cancel()
+		go func() {
+			workers.Wait()
+			close(results)
+			for got := range results {
+				if got.conn != nil {
+					_ = got.conn.Close()
+				}
+			}
+		}()
+	}
+
+	dial(primary[0], primary[0].To4() != nil)
+	primaryNext, fallbackNext, pending := 1, 0, 1
+	timer := time.NewTimer(noProxyFallbackDelay)
+	defer timer.Stop()
+	var timerC <-chan time.Time = timer.C
+	primaryV4 := primary[0].To4() != nil
+	var lastErr error
+	for pending > 0 {
+		select {
+		case <-ctx.Done():
+			cleanup()
+			return nil, ctx.Err()
+		case got := <-results:
+			pending--
+			if got.err == nil {
+				cleanup()
+				return got.conn, nil
+			}
+			if got.conn != nil {
+				_ = got.conn.Close()
+			}
+			lastErr = got.err
+			if got.ipv4 == primaryV4 && primaryNext < len(primary) {
+				dial(primary[primaryNext], primary[primaryNext].To4() != nil)
+				primaryNext++
+				pending++
+			} else if fallbackNext < len(fallback) {
+				dial(fallback[fallbackNext], fallback[fallbackNext].To4() != nil)
+				fallbackNext++
+				pending++
+			}
+		case <-timerC:
+			if ctx.Err() != nil {
+				cleanup()
+				return nil, ctx.Err()
+			}
+			if fallbackNext < len(fallback) {
+				dial(fallback[fallbackNext], fallback[fallbackNext].To4() != nil)
+				fallbackNext++
+				pending++
+			}
+			timerC = nil
+		}
+	}
+	cancel()
+	return nil, lastErr
+}
+
 type noProxy struct {
 	NoProxy
 }
