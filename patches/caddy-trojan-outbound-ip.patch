diff --git a/app/upstream_memory_test.go b/app/upstream_memory_test.go
new file mode 100644
index 0000000..ea765e8
--- /dev/null
+++ b/app/upstream_memory_test.go
@@ -0,0 +1,115 @@
+package app
+
+import (
+	"errors"
+	"sync"
+	"testing"
+)
+
+type recordedTask struct {
+	typ  TaskType
+	key  string
+	up   int64
+	down int64
+}
+
+type recordingUpstream struct {
+	mu    sync.Mutex
+	tasks []recordedTask
+}
+
+func (u *recordingUpstream) Add(password string) error {
+	u.record(TaskAdd, password, 0, 0)
+	return nil
+}
+
+func (u *recordingUpstream) Delete(password string) error {
+	u.record(TaskDelete, password, 0, 0)
+	return nil
+}
+
+func (u *recordingUpstream) Consume(key string, up, down int64) error {
+	u.record(TaskConsume, key, up, down)
+	return nil
+}
+
+func (*recordingUpstream) Range(func(string, int64, int64)) {}
+
+func (*recordingUpstream) Validate(string) bool { return false }
+
+func (u *recordingUpstream) record(typ TaskType, key string, up, down int64) {
+	u.mu.Lock()
+	u.tasks = append(u.tasks, recordedTask{typ: typ, key: key, up: up, down: down})
+	u.mu.Unlock()
+}
+
+func TestMemoryUpstreamCleanupFlushesPersistenceQueue(t *testing.T) {
+	persist := new(recordingUpstream)
+	u := &MemoryUpstream{mm: make(map[string]Traffic)}
+	u.startPersistenceWorker(persist)
+
+	if err := u.Add("password"); err != nil {
+		t.Fatal(err)
+	}
+	if err := u.Consume("key", 12, 34); err != nil {
+		t.Fatal(err)
+	}
+	if err := u.Delete("password"); err != nil {
+		t.Fatal(err)
+	}
+	if err := u.Cleanup(); err != nil {
+		t.Fatal(err)
+	}
+	if err := u.Cleanup(); err != nil {
+		t.Fatalf("second Cleanup returned an error: %v", err)
+	}
+
+	persist.mu.Lock()
+	defer persist.mu.Unlock()
+	if len(persist.tasks) != 3 {
+		t.Fatalf("persisted %d tasks, want 3", len(persist.tasks))
+	}
+	if persist.tasks[0].typ != TaskAdd || persist.tasks[0].key != "password" {
+		t.Fatalf("first task = %#v, want add", persist.tasks[0])
+	}
+	if persist.tasks[1] != (recordedTask{typ: TaskConsume, key: "key", up: 12, down: 34}) {
+		t.Fatalf("second task = %#v, want consume", persist.tasks[1])
+	}
+	if persist.tasks[2].typ != TaskDelete || persist.tasks[2].key != "password" {
+		t.Fatalf("third task = %#v, want delete", persist.tasks[2])
+	}
+}
+
+func TestMemoryUpstreamRejectsChangesAfterCleanup(t *testing.T) {
+	persist := new(recordingUpstream)
+	u := &MemoryUpstream{mm: make(map[string]Traffic)}
+	u.startPersistenceWorker(persist)
+	if err := u.Cleanup(); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := u.Add("late"); !errors.Is(err, errMemoryUpstreamClosed) {
+		t.Fatalf("Add error = %v, want errMemoryUpstreamClosed", err)
+	}
+	if err := u.Delete("late"); !errors.Is(err, errMemoryUpstreamClosed) {
+		t.Fatalf("Delete error = %v, want errMemoryUpstreamClosed", err)
+	}
+	if err := u.Consume("late", 1, 2); !errors.Is(err, errMemoryUpstreamClosed) {
+		t.Fatalf("Consume error = %v, want errMemoryUpstreamClosed", err)
+	}
+	if u.Validate("late") {
+		t.Fatal("closed upstream accepted a late in-memory mutation")
+	}
+}
+
+func TestTrojanStorageKeyValidation(t *testing.T) {
+	valid := "e440ce027e5051c38cdf3e47a3d469734e2de6e50d21ed2f0f460ba4"
+	if !isTrojanStorageKey(valid) {
+		t.Fatal("valid Trojan storage key was rejected")
+	}
+	for _, invalid := range []string{"1213882035", valid[:55], valid[:55] + "z"} {
+		if isTrojanStorageKey(invalid) {
+			t.Fatalf("invalid Trojan storage key was accepted: %q", invalid)
+		}
+	}
+}
