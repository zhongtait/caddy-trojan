+func (u *errorUpstream) Add(string) error                 { return u.addErr }
+func (u *errorUpstream) Delete(string) error              { return u.deleteErr }
+func (*errorUpstream) Range(func(string, int64, int64))   {}
+func (*errorUpstream) Validate(string) bool               { return false }
+func (*errorUpstream) Consume(string, int64, int64) error { return nil }
