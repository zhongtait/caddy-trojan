+}
+
+func (u *targetTrafficUpstream) ConsumeTarget(string, string, int64, int64) error { return nil }
+func (u *targetTrafficUpstream) RangeTargets(fn func(string, string, int64, int64)) {
+	for _, item := range u.targets {
+		fn(item.Key, item.Target, item.Up, item.Down)
+	}
