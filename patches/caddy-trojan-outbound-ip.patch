 }
 
+func (p *NoProxy) prioritizedIPs(ips []net.IP) (primary, fallback []net.IP) {
+	for _, ip := range ips {
+		isV4 := ip.To4() != nil
+		if (p.Network == "ipv4" && isV4) || (p.Network == "ipv6" && !isV4) {
+			primary = append(primary, ip)
+		} else {
+			fallback = append(fallback, ip)
+		}
+	}
+	return primary, fallback
+}
+
+func dialTCPPreferred(port string, primary, fallback []net.IP) (net.Conn, error) {
+	type result struct {
+		conn net.Conn
+		err  error
+		ipv4 bool
+	}
+	if len(primary) == 0 {
+		primary, fallback = fallback, nil
+	}
+	if len(primary) == 0 {
+		return nil, errors.New("no IP address found")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	results := make(chan result)
+	dial := func(ip net.IP, ipv4 bool) {
+		go func() {
+			conn, err := (&net.Dialer{}).DialContext(ctx, "tcp", net.JoinHostPort(ip.String(), port))
+			got := result{conn: conn, err: err, ipv4: ipv4}
+			if ctx.Err() != nil {
+				if conn != nil {
+					conn.Close()
+				}
+				return
+			}
+			select {
+			case results <- got:
+			case <-ctx.Done():
+				if conn != nil {
+					conn.Close()
+				}
+			}
+		}()
+	}
+	dial(primary[0], primary[0].To4() != nil)
+	primaryNext, fallbackNext, pending := 1, 0, 1
+	timer := time.NewTimer(300 * time.Millisecond)
+	defer timer.Stop()
+	var lastErr error
+	for pending > 0 {
+		select {
+		case got := <-results:
+			pending--
+			if got.err == nil {
+				return got.conn, nil
+			}
+			lastErr = got.err
+			if got.ipv4 == (primary[0].To4() != nil) && primaryNext < len(primary) {
+				dial(primary[primaryNext], primary[primaryNext].To4() != nil)
+				primaryNext++
+				pending++
+			} else if fallbackNext < len(fallback) {
+				dial(fallback[fallbackNext], fallback[fallbackNext].To4() != nil)
+				fallbackNext++
+				pending++
+			}
+		case <-timer.C:
+			if fallbackNext < len(fallback) {
+				dial(fallback[fallbackNext], fallback[fallbackNext].To4() != nil)
+				fallbackNext++
+				pending++
+			}
+		}
+	}
+	return nil, lastErr
+}
+
 type noProxy struct {
 	NoProxy
 }
