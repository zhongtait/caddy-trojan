+	"testing"
+)
+
+type errorUpstream struct {
+	addErr    error
+	deleteErr error
+}
+
+func (u *errorUpstream) Add(string) error                 { return u.addErr }
+func (u *errorUpstream) Delete(string) error              { return u.deleteErr }
+func (*errorUpstream) Range(func(string, int64, int64))   {}
+func (*errorUpstream) Validate(string) bool               { return false }
+func (*errorUpstream) Consume(string, int64, int64) error { return nil }
+
+func TestAddUserReturnsPersistenceError(t *testing.T) {
+	want := errors.New("add failed")
+	handler := &Admin{upstream: &errorUpstream{addErr: want}}
+	req := httptest.NewRequest(http.MethodPost, "/trojan/users/add", bytes.NewBufferString(`{"password":"secret"}`))
+	err := handler.AddUser(httptest.NewRecorder(), req)
+	if !errors.Is(err, want) {
+		t.Fatalf("AddUser error = %v, want %v", err, want)
+	}
+}
+
+func TestDeleteUserReturnsPersistenceError(t *testing.T) {
+	want := errors.New("delete failed")
+	handler := &Admin{upstream: &errorUpstream{deleteErr: want}}
+	req := httptest.NewRequest(http.MethodDelete, "/trojan/users/delete", bytes.NewBufferString(`{"password":"secret"}`))
+	err := handler.DeleteUser(httptest.NewRecorder(), req)
+	if !errors.Is(err, want) {
+		t.Fatalf("DeleteUser error = %v, want %v", err, want)
+	}
+}
