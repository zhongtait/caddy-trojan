+package handler
+
+import (
+	"context"
+	"net/http"
+	"testing"
+
+	"github.com/caddyserver/caddy/v2/modules/caddyhttp"
+)
+
+func TestClientIPFromRequestUsesValidatedClientIP(t *testing.T) {
+	requestContext := context.WithValue(context.Background(), caddyhttp.VarsCtxKey, map[string]any{})
+	r, err := http.NewRequestWithContext(requestContext, http.MethodGet, "http://example.com", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r.RemoteAddr = "173.245.48.1:443"
+	caddyhttp.SetVar(r.Context(), caddyhttp.ClientIPVarKey, "198.51.100.20")
+	if got := clientIPFromRequest(r); got != "198.51.100.20" {
+		t.Fatalf("client IP = %q, want validated client IP", got)
+	}
+}
+
+func TestClientIPFromRequestFallsBackToPeer(t *testing.T) {
+	r, err := http.NewRequest(http.MethodGet, "http://example.com", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r.RemoteAddr = "192.0.2.10:443"
+	if got := clientIPFromRequest(r); got != "192.0.2.10" {
+		t.Fatalf("client IP = %q, want peer IP", got)
+	}
+}
