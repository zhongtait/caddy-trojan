-func (*NoProxy) Dial(network, addr string) (net.Conn, error) {
-	return net.Dial(network, addr)
+func (p *NoProxy) Dial(network, addr string) (net.Conn, error) {
+	if p.Network == "" || (network != "tcp" && network != "udp") {
+		return net.Dial(network, addr)
+	}
+	host, port, err := net.SplitHostPort(addr)
+	if err != nil || net.ParseIP(host) != nil {
+		return net.Dial(network, addr)
+	}
+	ips, err := net.LookupIP(host)
+	if err != nil {
+		return nil, err
+	}
+	primary, fallback := p.prioritizedIPs(ips)
+	if network == "udp" {
+		if len(primary) == 0 {
+			primary = fallback
+		}
+		if len(primary) == 0 {
+			return nil, fmt.Errorf("no IP address found for %s", host)
+		}
+		return net.Dial(network, net.JoinHostPort(primary[0].String(), port))
+	}
+	return dialTCPPreferred(port, primary, fallback)
 }
 
